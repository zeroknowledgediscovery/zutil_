symbol_list_& nextstatew(symbol_list_& statew,unsigned int alphabet)
{
  if(statew.back()==symbol (alphabet-1))
    {
      statew.push_back(symbol(0));
      statew.erase(statew.begin());
    }
  else
    statew.back()=statew.back()+1;
  return statew;
}


